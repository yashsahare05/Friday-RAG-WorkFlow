GOOGLE_APPLICATION_CREDENTIALS=./vision_key.json
CHROMA_PATH=../data/chroma_db
UPLOAD_DIR=../data/uploads
REPORTS_DIR=../data/reports
LOGS_DIR=../data/logs
OLLAMA_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
